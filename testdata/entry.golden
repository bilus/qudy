package generator

// generateDispatchEntry writes the table's entry for one handler, on the
// receiver or on the nested instance the steps lead to.
func (g *liveGenerator) generateDispatchEntry(name string, steps []navStep, recv string, h handlerBinding) {
	qudyGensym := func() func(string) string {
		counts := map[string]int{}
		return func(want string) string {
			counts[want]++
			digits := ""
			for n := counts[want]; n > 0; n /= 10 {
				digits = string(rune('0'+n%10)) + digits
			}
			return want + "_qd" + digits
		}
	}()
	params := valueParams(h.sig)
	event := "_"
	if len(params) > 0 || h.fill != "" {
		event = qudyGensym("e")
	}
	var locals []string
	g.generate(`%v: func(lv live.Ctx, %v live.Event) error {
`, strconv.Quote(name), event)
	for _, p := range params {
		local := qudyGensym(p.Name)
		locals = append(locals, local)
		errName_qd := qudyGensym("errName")
		g.generate(`%v, %v := live.Param[%v](%v, %v)
if %v != nil {
	return %v
}
`, local, errName_qd, p.Type.Text, event, strconv.Quote(p.Name), errName_qd, errName_qd)
	}
	for i, s := range steps {
		if i > 0 {
			g.generate(`{
`)
		}
		g.generate(`%v := %v
`, s.param, s.state)
		recv = s.param
	}
	fill, callee := h.fill, h.method
	if h.field != "" {
		callee = h.field + "." + h.method
	}
	if fill != "" {
		decodeErr_qd := qudyGensym("decodeErr")
		ruleErr_qd := qudyGensym("ruleErr")
		g.generate(`if %v := form.Decode(&%v.%v, %v); %v != nil {
	return %v
}
if %v := form.Validate(&%v.%v); %v != nil {
	return %v
}
return form.Update(&%v.%v, func() {
`, decodeErr_qd, recv, fill, event, decodeErr_qd, decodeErr_qd, ruleErr_qd, recv, fill, ruleErr_qd, ruleErr_qd, recv, fill)
	}
	g.generate(`%v.%v(lv`, recv, callee)
	for _, s := range steps {
		if s.id != "" {
			g.generate(`.WithID(%v)`, strconv.Quote(s.id))
		}
	}
	for _, local := range locals {
		g.generate(`, %v`, local)
	}
	g.generate(`)
`)
	if fill != "" {
		g.generate(`})
`)
	} else {
		g.generate(`return nil
`)
	}
	for range max(len(steps)-1, 0) {
		g.generate(`}
`)
	}
	g.generate(`},
`)
}
